<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>CDrama Tracker</title>
</head>

<body>
    <%- include('partials/navbar') %>
        <div class="container mt-4">
            <h2 class="text-start mb-4">Update Drama</h2>

            <form action="/updateDrama/<%= id %>" method="POST">

                <div class="mb-3">
                    <label for="dramaName">Drama Name:</label>
                    <input type="text" name="dramaName" class="form-control" value="<%= drama.dramaName %>">
                </div>

                <div class="mb-3">
                    <label for="ratings">Rating:</label>
                    <select name="ratings" class="form-select">
                        <option value="1/5" <%= drama.ratings === "1/5" ? "selected" : "" %>>1/5</option>
                        <option value="2/5" <%= drama.ratings === "2/5" ? "selected" : "" %>>2/5</option>
                        <option value="3/5" <%= drama.ratings === "3/5" ? "selected" : "" %>>3/5</option>
                        <option value="4/5" <%= drama.ratings === "4/5" ? "selected" : "" %>>4/5</option>
                        <option value="5/5" <%= drama.ratings === "5/5" ? "selected" : "" %>>5/5</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="comments">Comments:</label>
                    <textarea name="comments" class="form-control"><%= drama.comments %></textarea>
                </div>

                <button type="submit" class="btn btn-primary">
                    Update Drama
                </button>

            </form>

        </div>

</body>

</html>